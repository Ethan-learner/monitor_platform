[Unit]
Description=Monitor Portal Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/monitor/backend
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=/data/monitor/backend/.env

[Install]
WantedBy=multi-user.target
