# ============================================
# 统一监控告警平台 - 生产环境配置
# 复制为 backend/.env 并填写实际值
# ============================================

PORTAL_JWT_SECRET=请替换为随机密钥
PORTAL_DEV_MOCK=false

# SSH（如果后端部署在目标服务器上，此项留空）
PORTAL_SSH_HOST=
PORTAL_SSH_PORT=22
PORTAL_SSH_USER=
PORTAL_SSH_PASSWORD=

# 告警规则文件目录（Prometheus 服务器上的路径）
PORTAL_ALERTS_DIR=/data/software/prometheus/alerts

# Prometheus 抓取目标目录
PORTAL_PROMETHEUS_TARGETS_DIR=/data/software/prometheus/prometheus_targets

# MySQL 元数据库
PORTAL_MYSQL_WRITE_HOST=172.16.10.99
PORTAL_MYSQL_WRITE_PORT=3308
PORTAL_MYSQL_READ_HOST=172.16.10.99
PORTAL_MYSQL_READ_PORT=3309
PORTAL_MYSQL_USER=monitor
PORTAL_MYSQL_PASSWORD=123456
PORTAL_MYSQL_DATABASE=platform

# Webhook 集群
PORTAL_WEBHOOK_NODES=http://172.16.10.27:8090,http://172.16.10.28:8090,http://172.16.10.29:8090

# 域控认证
PORTAL_EIP_URL=http://eip.longcheer.com:8009/api/v1/common/user/login
